{
  "_comment": "Merged into every role snippet. Fleet control commands + the shared deny floor. Deny beats allow in every mode.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$FLEET_HOME/bin/fleet-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$FLEET_HOME/bin/fleet-state.sh working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$FLEET_HOME/bin/fleet-state.sh working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$FLEET_HOME/bin/fleet-state.sh idle"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$FLEET_HOME/bin/fleet-state.sh notification"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash($FLEET_HOME/bin/reset-agent.sh:*)",
      "Bash($FLEET_HOME/bin/switch-task.sh:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-windows:*)",
      "ListAgents",
      "SendMessage",
      "Read",
      "Glob",
      "Grep",
      "Monitor",
      "TaskOutput",
      "TaskStop",
      "TaskList",
      "ToolSearch",
      "Skill",
      "Bash($FLEET_HOME/bin/mr-edit.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/credentials*)",
      "Edit(**/secrets/**)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push upstream:*)",
      "Bash(git push --mirror:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr approve:*)",
      "Bash(glab mr close:*)",
      "Bash(glab api --method PUT:*)",
      "Bash(glab api --method DELETE:*)",
      "Bash(env -u GITLAB_TOKEN glab mr merge:*)",
      "Bash(env -u GITLAB_TOKEN glab mr approve:*)",
      "Bash(env -u GITLAB_TOKEN glab api --method PUT:*)",
      "Bash(env -u GITLAB_TOKEN glab api --method DELETE:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
